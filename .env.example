# Copiá este archivo a .env.local y completá los valores.
# .env.local está gitignoreado: nunca se commitea.
#
# IMPORTANTE: Next inlinea las NEXT_PUBLIC_* en tiempo de BUILD.
# Si cambiás algo acá hay que rehacer `next build` y `npx cap sync`,
# no alcanza con reiniciar la app.

# Supabase > Project Settings > API
# El project ref está en la URL del dashboard:
#   supabase.com/dashboard/project/<ESTE_ES_EL_REF>
NEXT_PUBLIC_SUPABASE_URL=https://<TU_PROJECT_REF>.supabase.co

# Supabase > Project Settings > API Keys > "Publishable key" (sb_publishable_...)
# o, en la UI vieja, "anon public". Es pública por diseño: viaja en el APK.
# NUNCA pongas acá la service_role / secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública donde está desplegada la web. Dos usos: el link del mail de
# recuperación de contraseña, y el link que se manda al compartir un plan.
# Dentro del APK, window.location.origin es "https://localhost", así que sin
# esto ninguno de los dos lleva a ningún lado.
#
# Tiene que ser una URL REAL. Si copiás un texto de ejemplo con <corchetes>
# o que diga "tu-dominio", el build avisa y la app comparte sin link — es
# mejor eso que mandar por WhatsApp un link que no existe.
# Ejemplo: https://nahufigueroa97.github.io/Pinto
NEXT_PUBLIC_SITE_URL=

# Prefijo de ruta. SOLO para publicar la web en un repo de proyecto de GitHub
# Pages, que se sirve bajo /<repo>/. NO lo definas para compilar la APK:
# Capacitor sirve desde la raiz de su servidor local y con prefijo no
# encontraria nada. El workflow de Pages lo define solo.
# NEXT_PUBLIC_BASE_PATH=/Pinto
